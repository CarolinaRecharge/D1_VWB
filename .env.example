# D1 Training Gym Workout Whiteboard — Environment Variables
#
# Copy this file to .env for local development with `vercel dev`.
# For Vercel deployment, set these in your project's Settings → Environment Variables.
#
# NEVER commit the actual .env file to git.

# Supabase project URL (found in Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key — safe for read-only TV display access
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key — used by admin page only, bypasses RLS
# Keep this secret. Do not expose in client-side code.
SUPABASE_SERVICE_KEY=your-service-role-key-here
